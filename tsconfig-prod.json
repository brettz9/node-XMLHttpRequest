{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "target": "es2024",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.js", "src/**/*.cts"]
}
