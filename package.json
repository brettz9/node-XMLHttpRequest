{
  "name": "local-xmlhttprequest",
  "type": "module",
  "main": "./src/XMLHttpRequest.js",
  "exports": {
    "import": {
      "types": "./dist/XMLHttpRequest.d.ts",
      "default": "./src/XMLHttpRequest.js"
    },
    "require": {
      "types": "./dist/XMLHttpRequest.d.cts",
      "default": "./dist/XMLHttpRequest.cjs"
    }
  },
  "description": "XMLHttpRequest for Node",
  "version": "4.0.0",
  "author": {
    "name": "Brett Zamir",
    "email": "brettz9@yahoo.com",
    "url": "http://brett-zamir.me)"
  },
  "contributors": [
    "Dan DeFelippi (http://driverdan.com)"
  ],
  "keywords": [
    "xhr",
    "ajax"
  ],
  "c8": {
    "check-coverage": true,
    "statements": 100,
    "lines": 100,
    "branches": 100,
    "functions": 100,
    "exclude": [
      "tests",
      "scripts/run-tests.js"
    ]
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm attw",
    "tsc": "tsc",
    "attw": "attw --pack . --profile node16",
    "rollup": "rollup -c",
    "build": "pnpm rollup && tsc -p tsconfig-prod.json",
    "lint": "npm run eslint",
    "eslint": "eslint .",
    "test": "c8 node scripts/run-tests.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/brettz9/node-XMLHttpRequest.git"
  },
  "homepage": "https://github.com/brettz9/node-XMLHttpRequest",
  "bugs": "https://github.com/brettz9/node-XMLHttpRequest/issues",
  "engines": {
    "node": "^22.18.0 || >= 24.11.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "c8": "^12.0.0",
    "eslint": "10.11.0",
    "eslint-config-ash-nazg": "43.2.2",
    "globals": "^17.12.0",
    "rollup": "^4.63.4",
    "typescript": "^7.0.2"
  },
  "directories": {
    "lib": "./lib",
    "example": "./example"
  },
  "dependencies": {
    "@types/node": "^26.6.2"
  }
}
